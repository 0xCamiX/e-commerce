{
  "name": "store",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
