    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.19.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.511.0",
    "next": "^16.1.6",
